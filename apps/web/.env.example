# Public values only — no private key ever ships to the browser.
NEXT_PUBLIC_SHANNON_CHAIN_ID=50312
NEXT_PUBLIC_EC_VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c
NEXT_PUBLIC_SHANNON_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
NEXT_PUBLIC_SHANNON_WS_URL=wss://api.infra.testnet.somnia.network/ws

# The wallet Echonome places echoes from. Followers grant THIS address permission to
# place and cancel orders for them — and nothing else. Must match OPERATOR_PRIVATE_KEY's
# address in apps/worker/.env.
NEXT_PUBLIC_OPERATOR_ADDRESS=

# DreamDEX's OperatorPermissionsRegistry. Absent from the SDK's SOMNIA_TESTNET_ADDRESSES;
# read off a live spot pool and confirmed against DreamDEX's published Operators page.
# Optional — lib/somnia.ts falls back to this same value. Mainnet is
# 0xE7a190736B6024a4DbafadC04E283075877005ce.
#
# Knowing it does not enable copy-trading: this registry governs spot pools only, and an
# Event Contract pool ignores it. Proven on chain — see FEEDBACK.md, or run
# `npm run verify:operator-gate` in apps/worker.
NEXT_PUBLIC_OPERATOR_REGISTRY_ADDRESS=0x15C7e8CE38F021c5b45d098AaD788f63090bF20A

# Same database the worker writes to.
DATABASE_URL=postgres://user:password@localhost:5432/echonome
