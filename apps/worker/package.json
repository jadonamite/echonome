{
  "name": "@echonome/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "seed": "tsx --env-file-if-exists=.env src/seeds/runSeedTraders.ts",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "test": "vitest run",
    "verify:custody": "tsx --env-file-if-exists=.env src/testnetVerifyCustody.ts",
    "verify:operator-gate": "tsx --env-file-if-exists=.env src/testnetVerifyOperatorGate.ts",
    "health": "tsx --env-file-if-exists=.env src/healthCli.ts",
    "recompute": "tsx --env-file-if-exists=.env src/recomputeAll.ts",
    "demo:follower": "tsx --env-file-if-exists=.env src/setupDemoFollower.ts",
    "seeds:provision": "tsx --env-file-if-exists=.env src/provisionSeeds.ts"
  },
  "dependencies": {
    "@echonome/shared": "*",
    "@somnia-chain/markets-sdk": "^0.29.0",
    "viem": "^2.21.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
