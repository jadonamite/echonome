DATABASE_URL=postgres://user:password@localhost:5432/echonome

SHANNON_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
SHANNON_WS_URL=wss://api.infra.testnet.somnia.network/ws
EC_VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

# Dedicated fresh testnet wallet — never reused, never a real-value key.
OPERATOR_PRIVATE_KEY=

# Comma-separated, one per seed strategy (ec-maker, ec-oracle-follow, ...).
SEED_TRADER_PRIVATE_KEYS=

# EchoAccountFactory — one per chain, deploys a follower's own trading account.
# Shannon testnet, deployed 2026-09-09. Verify with:
#   npm run verify:custody -w @echonome/contracts
ECHO_ACCOUNT_FACTORY=0xcee09039dc8020e01a12387eaa37b6a257b793d7

# Echoes per minute, sliding window. Default 20. Too low for a leader that trades every few
# seconds — one follower copying ec-maker hit it 28 times in half an hour — but raising it
# weakens the cap that stops a runaway from draining an account one valid order at a time.
MIRROR_MAX_ECHOES_PER_MINUTE=20
